# ==========================================
# نموذج متغيرات البيئة لمبادرة المنح الدراسية
# انسخ هذا الملف إلى .env.local وقم بتعبئة القيم الحقيقية
# لا تضع أي كلمات مرور أو مفاتيح سرية في المستودع
# ==========================================

# 1. إعدادات الاتصال بقاعدة بيانات MongoDB Atlas (الخطة المجانية Free M0)
# احصل على الرابط من لوحة تحكم MongoDB Atlas > Connect > Drivers > Node.js
# ملاحظة هامة: هذا المتغير سري ويعمل على الخادم فقط (لا تسبقه بـ NEXT_PUBLIC)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority

# اسم قاعدة البيانات
MONGODB_DB_NAME=scholarship_db

# 2. مفتاح تشفير وتوقيع جلسات الإدارة (JWT Secret)
# يجب أن يتكون من 32 حرفاً عشوائياً على الأقل لضمان أمان خوارزمية HS256
# يمكنك توليده عبر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=replace_this_with_a_secure_random_string_min_32_characters_long

# 3. عنوان المنصة (اختياري للتطوير المحلي)
NEXT_PUBLIC_APP_URL=http://localhost:3000
